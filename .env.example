# Copy to .env and fill in. Never commit .env.
#
# Generate each secret (32 random bytes, base64url) with:
#   docker run --rm node:24-bookworm-slim node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# or, from a built checkout:  npm run gen-secret
# The two secrets must differ.

# Secret path segment for apply/query/schema/mcp (required).
REMORA_SECRET=
# Secret path segment for the operator API; empty disables /admin routes.
REMORA_ADMIN_SECRET=
# Host port published by compose.
REMORA_PORT=8080
