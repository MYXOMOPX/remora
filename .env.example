# Copy to .env and fill in. Never commit .env.
#
# Generate each secret (32 random bytes, base64url) with:
#   docker run --rm node:24-bookworm-slim node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# or, from a built checkout:  npm run gen-secret
# The two secrets must differ.

# Secret path segment for apply/query/schema/mcp (required).
REMORA_SECRET=
# Secret path segment for the operator API; empty disables /admin routes.
REMORA_ADMIN_SECRET=
# Password of the compose database. Use a generated value (same command as for the secrets;
# base64url is safe inside the connection URL). Required: compose refuses to start without it.
POSTGRES_PASSWORD=
# Host port published by compose, on 127.0.0.1 only (see README to expose it behind a reverse proxy).
REMORA_PORT=8080
